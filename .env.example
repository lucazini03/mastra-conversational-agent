# ──────────────────────────────────────────────────────────────────────────────
# MemorAIz — Environment Variables
#
# Copy this file to .env and fill in the required values.
# NEVER commit your .env file to version control.
#
# Minimum required to run:
#   GEMINI_LIVE_API_KEY, GEMINI_LLM_API_KEY, GEMINI_EMBEDDING_API_KEY
# ──────────────────────────────────────────────────────────────────────────────


# ──────────────────────────────────────────────────────────────────────────────
# GOOGLE API KEYS
#
# You can use one key for all three purposes (same project, same quota) or
# split them across different keys/projects for independent quota management.
# All keys must have access to the Google AI / Generative Language API.
# ──────────────────────────────────────────────────────────────────────────────

# API key used by the Gemini Live (speech-to-speech) WebSocket connection.
# This is the primary key — it drives real-time voice conversation.
# Required. Get it from https://aistudio.google.com/apikey
GEMINI_LIVE_API_KEY=

# API key used by the two lightweight LLM calls that run as text generation:
#   1. Document topic-summary at session start (DocumentService)
#   2. Context-compaction extraction during WebSocket cycling (ContextManager)
# These calls use small/cheap models (Flash Lite), so quota pressure is low.
# Required.
GEMINI_LLM_API_KEY=

# API key used by the RAG embedding pipeline (BrowserRagService).
# Used to call the text-embedding model when building the vector index
# and when embedding a query string at search time.
# Required when document uploads are used. Can be the same as GEMINI_LLM_API_KEY.
GEMINI_EMBEDDING_API_KEY=


# ──────────────────────────────────────────────────────────────────────────────
# GEMINI MODEL NAMES
#
# You generally do not need to change these unless Google deprecates a model
# or you want to test a newer preview.
# ──────────────────────────────────────────────────────────────────────────────

# The Gemini Live (real-time audio) model used for voice conversation.
# Must be a model that supports the BidiGenerateContent (Live API) endpoint.
# Default: gemini-3.1-flash-live-preview
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# The text-only model used for:
#   - Document topic-summary generation at session start
#   - Context-compaction memory extraction during WebSocket cycling
# Default: gemini-3.1-flash-lite-preview
MEMORY_EXTRACTION_MODEL=gemini-3.1-flash-lite-preview

# Fallback model used for context-compaction extraction if MEMORY_EXTRACTION_MODEL fails.
# Default: gemini-2.5-flash-lite
MEMORY_EXTRACTION_MODEL_BACKUP=gemini-2.5-flash-lite


# ──────────────────────────────────────────────────────────────────────────────
# SERVER
# ──────────────────────────────────────────────────────────────────────────────

# TCP port the Express + WebSocket server listens on.
# Default: 3000
PORT=3000


# ──────────────────────────────────────────────────────────────────────────────
# RAG (Retrieval-Augmented Generation)
#
# Controls how uploaded documents are chunked, embedded, and searched.
# ──────────────────────────────────────────────────────────────────────────────

# Path to the DuckDB file used as the vector store.
# Default: rag.duckdb in the project root.
RAG_DUCKDB_PATH=rag.duckdb

# Base name of the vector index created inside DuckDB.
# Each session appends its sessionId to this name to avoid collisions:
# e.g. pdf_knowledge_a1b2c3d4
# Default: pdf_knowledge
RAG_INDEX_NAME=pdf_knowledge

# The text-embedding model to use for building the vector index and querying it.
# If not set, the service tries gemini-embedding-001 then gemini-embedding-2-preview.
# Leave blank to use the auto-detection logic.
RAG_EMBEDDING_MODEL=

# Maximum number of chunks returned by a single similarity search call.
# Higher values give the professor more context per RAG query but increase
# token usage. Tune based on your chunk size and document density.
# Default: 5
RAG_QUERY_TOP_K=5

# Minimum cosine similarity score (0.0–1.0) for a chunk to be included in results.
# Chunks below this threshold are discarded. Raise it to improve precision
# (fewer but more relevant chunks); lower it to improve recall.
# Default: 0.1
RAG_MIN_SCORE=0.1

# Maximum character length of each document chunk before embedding.
# Longer chunks capture more context per chunk but reduce retrieval precision.
# Shorter chunks are more precise but may miss surrounding context.
# Default: 1200
RAG_CHUNK_MAX_SIZE=1200

# Character overlap between consecutive chunks.
# Overlap ensures that sentences near a chunk boundary appear in both chunks,
# reducing the chance of splitting a key sentence across chunks.
# Default: 200
RAG_CHUNK_OVERLAP=200

# Number of chunks to embed in a single API batch call.
# Higher values reduce the number of API round-trips but increase per-call latency.
# Reduce this if you hit rate limits during the index-build phase.
# Default: 100
RAG_EMBED_BATCH_SIZE=100


# ──────────────────────────────────────────────────────────────────────────────
# CONTEXT COMPACTION (WebSocket Token Cycling)
#
# When the cumulative input-token count for the current WebSocket connection
# exceeds the threshold, the ContextManager extracts a compact JSON summary
# of the conversation, opens a fresh WebSocket with that summary injected into
# the system prompt, and closes the old one. This keeps per-turn costs low
# regardless of session length.
# ──────────────────────────────────────────────────────────────────────────────

# Input-token delta that triggers a context-compaction extraction.
# "Delta" means tokens since the last compaction switch, not the session total.
# Increase to compact less often (cheaper extraction but higher per-turn Live cost).
# Decrease to compact more aggressively (more extraction calls but lower peak Live cost).
# Default: 50000
MEMORY_EXTRACTION_TOKEN_THRESHOLD=50000


# ──────────────────────────────────────────────────────────────────────────────
# COST TRACKING (optional)
#
# If you set these, SessionCostTracker will compute USD estimates for each
# session and include them in the session log. Prices are per 1 million tokens.
# If left blank, token counts are still tracked but cost fields will be null.
#
# Find current prices at https://ai.google.dev/pricing
# ──────────────────────────────────────────────────────────────────────────────

# Price (USD) per 1 million text INPUT tokens for the Gemini Live model.
# Covers the system prompt, transcript text injected into context, and tool results.
GOOGLE_PRICE_TEXT_INPUT_PER_1M=0.75

# Price (USD) per 1 million text OUTPUT tokens for the Gemini Live model.
# Covers the professor's text transcript output.
GOOGLE_PRICE_TEXT_OUTPUT_PER_1M=4.50

# Price (USD) per 1 million audio INPUT tokens for the Gemini Live model.
# Covers student microphone audio streamed to the API.
GOOGLE_PRICE_AUDIO_INPUT_PER_1M=3.00

# Price (USD) per 1 million audio OUTPUT tokens for the Gemini Live model.
# Covers the professor's synthesised speech audio.
GOOGLE_PRICE_AUDIO_OUTPUT_PER_1M=12.00

# Price (USD) per 1 million text INPUT tokens for the lightweight LLM models
# (document summary + context-compaction extraction). These use Flash Lite,
# which is priced significantly lower than the Live model.
GOOGLE_PRICE_TEXT_INPUT_PER_1M_LITE=0.25

# Price (USD) per 1 million text OUTPUT tokens for the lightweight LLM models.
GOOGLE_PRICE_TEXT_OUTPUT_PER_1M_LITE=1.5